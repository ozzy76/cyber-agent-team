# BATeam environment configuration.
# Copy to `.env` for local dev; do NOT commit .env.

# ---------------------------------------------------------------------------
# Local Ollama
# ---------------------------------------------------------------------------
# Default: http://localhost:11434
# Set if Ollama runs on a different host or non-default port.
OLLAMA_HOST=http://localhost:11434

# How long Ollama keeps a model resident in RAM after a request. The default
# is 5 minutes; on a 24 GB Mac M4 we want longer to avoid 6–10 s cold-load
# penalties when the orchestrator hands off and comes back.
OLLAMA_KEEP_ALIVE=20m

# Hard ceiling on simultaneously loaded models. All 5 agents bind to
# gemma4:12b (~8 GB resident), so 1 is sufficient — orchestrator hand-offs
# never cross a model boundary. Raise only if you wire a heterogeneous
# setup (e.g. a sidecar model for cti_mgr).
OLLAMA_MAX_LOADED_MODELS=1

# ---------------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------------
# `local` (default) → each agent uses its Ollama default model.
# `prod`             → each agent uses its production (Vertex AI / Gemini / Claude) model.
BATEAM_ENV=local

# ---------------------------------------------------------------------------
# Optional global model override
# ---------------------------------------------------------------------------
# When set, ALL agents use this model regardless of their per-agent default.
# Useful for quick experiments. Examples:
#   BATEAM_MODEL_OVERRIDE=ollama/llama3.1:8b
#   BATEAM_MODEL_OVERRIDE=gemini-2.5-flash
# BATEAM_MODEL_OVERRIDE=

# ---------------------------------------------------------------------------
# Production: GCP / Vertex AI
# ---------------------------------------------------------------------------
# Set these when BATEAM_ENV=prod or when deploying to Cloud Run.
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Web search (research tool)
# ---------------------------------------------------------------------------
# Wires a live `web_search` tool into every agent so research-driven skills
# (e.g. osint-collection) can ground their work in real results instead of
# assuming a capability that isn't there. Off by default; when on, the tool
# is registered only if the
# active provider's credentials are also present (otherwise it logs a warning
# and registers nothing — so the model never sees a tool that always errors).
# BATEAM_WEB_SEARCH=1

# Provider dispatch. Default is Gemini grounding with Google Search — Google's
# supported web-search path for new customers. The module is provider-pluggable
# (google_pse legacy; tavily/brave/searxng can be added later); this selects
# which one is active.
# BATEAM_SEARCH_PROVIDER=gemini_grounding

# Gemini grounding credentials (provider=gemini_grounding):
#   - GEMINI_API_KEY: an AI Studio API key (https://aistudio.google.com/apikey).
#     Grounding is billed per search query the model runs; AI Studio has a dev
#     free tier. Source URLs come back as Google grounding-redirect links that
#     resolve to the real page.
#   - BATEAM_GEMINI_GROUNDING_MODEL: optional, defaults to gemini-2.5-flash.
# GEMINI_API_KEY=
# BATEAM_GEMINI_GROUNDING_MODEL=gemini-2.5-flash

# Legacy provider (provider=google_pse): the Custom Search JSON API is CLOSED TO
# NEW CUSTOMERS and shuts down 2027-01-01. Only usable on an existing Custom
# Search project. Both values required:
#   - GOOGLE_PSE_API_KEY: a Google Cloud API key with "Custom Search API" enabled.
#   - GOOGLE_PSE_CX: the search-engine id from programmablesearchengine.google.com
# GOOGLE_PSE_API_KEY=
# GOOGLE_PSE_CX=

# ---------------------------------------------------------------------------
# Tool-call audit log
# ---------------------------------------------------------------------------
# Every tool invocation (MCP, FunctionTool, SkillToolset, bash) gets one
# JSONL record via ADK's after_tool_callback. Default sink is the XDG state
# dir; override here for prod (typically a Cloud Logging sink).
# BATEAM_AUDIT_LOG=~/.local/state/bateam/audit.jsonl

# ---------------------------------------------------------------------------
# Uploaded artifacts (read_artifact / list_artifacts)
# ---------------------------------------------------------------------------
# Hard cap on decoded artifact size, in bytes. Files larger than this
# are rejected by read_artifact to protect the model's context window.
# Default 10 MiB.
# BATEAM_MAX_ARTIFACT_BYTES=10485760

# When set, ADK's Runner can be wired (in your deployment entrypoint) to
# use GcsArtifactService for persistence across restarts. Local dev uses
# InMemoryArtifactService implicitly via `adk web`; nothing to set.
# BATEAM_ARTIFACT_BUCKET=bateam-artifacts
